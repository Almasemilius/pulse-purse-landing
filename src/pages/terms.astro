---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="Terms of Service — Pulse Purse"
  description="The terms for using Pulse Purse."
  noindex
>
  <Header />
  <main class="container legal">
    <h1>Terms of Service</h1>
    <p class="muted">
      This page is a placeholder. Replace with real terms before public signups open.
    </p>
  </main>
  <Footer />
</Layout>
<style>
  .legal { padding-block: 4rem; max-width: 680px; }
  .legal h1 { margin-bottom: 1.25rem; }
</style>
