---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { CONTACT_API_URL } from '../lib/site';
---
<Layout
  title="Contact — Pulse Purse"
  description="Get in touch with the Pulse Purse team."
>
  <Header />

  <main class="container contact">
    <h1>Get in touch</h1>
    <p class="muted lede">
      Question, bug, feature idea — whatever it is, this goes straight to us.
    </p>

    <form id="contact-form" class="contact-form" novalidate data-endpoint={CONTACT_API_URL}>
      <div class="field">
        <label for="name">Name</label>
        <input id="name" name="name" type="text" required maxlength="100" autocomplete="name" />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required maxlength="255" autocomplete="email" />
      </div>
      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" required maxlength="4000" rows="6"></textarea>
      </div>

      <!-- Honeypot: hidden from real visitors via CSS, bots fill every field. -->
      <div class="field hp" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <button type="submit" class="btn btn-primary" id="contact-submit">Send message</button>
      <p id="contact-status" class="status" role="status" aria-live="polite"></p>
    </form>

    <div class="elsewhere">
      <p class="muted">Or find us on</p>
      <SocialLinks />
    </div>
  </main>

  <Footer />

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
    const status = document.getElementById('contact-status') as HTMLParagraphElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const endpoint = form.dataset.endpoint;
      if (!endpoint) return;

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get('name') || '').trim(),
        email: String(formData.get('email') || '').trim(),
        message: String(formData.get('message') || '').trim(),
        company: String(formData.get('company') || ''),
      };

      if (!payload.name || !payload.email || !payload.message) {
        status.textContent = 'Please fill in your name, email and message.';
        status.dataset.state = 'error';
        return;
      }

      submitBtn.disabled = true;
      status.textContent = 'Sending…';
      status.dataset.state = '';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(`Request failed: ${res.status}`);

        status.textContent = "Thanks — we've got it and will get back to you soon.";
        status.dataset.state = 'success';
        form.reset();
      } catch (err) {
        console.error(err);
        status.textContent = "Something went wrong sending that. Try again, or email us directly.";
        status.dataset.state = 'error';
      } finally {
        submitBtn.disabled = false;
      }
    });
  </script>
</Layout>

<style>
  .contact {
    padding-block: 4rem;
    max-width: 560px;
  }
  .lede {
    margin-top: 0.5rem;
    margin-bottom: 2.5rem;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .field label {
    font-size: 0.9rem;
    font-weight: 500;
  }
  .field input,
  .field textarea {
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--foreground);
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: 2px solid var(--ring);
    outline-offset: 1px;
  }
  /* Honeypot: off-screen, not display:none (some bots skip hidden fields but not off-screen ones). */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact-form .btn {
    align-self: flex-start;
  }
  .status {
    font-size: 0.9rem;
    min-height: 1.2em;
    color: var(--muted-foreground);
  }
  .status[data-state='success'] {
    color: var(--gain);
  }
  .status[data-state='error'] {
    color: var(--loss, #b3261e);
  }
  .elsewhere {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 1rem;
  }
</style>
