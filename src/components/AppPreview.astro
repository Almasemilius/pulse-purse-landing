---
const BASE = 'https://res.cloudinary.com/do6zpq1dx/image/upload';
const SHOTS = [
  { src: `${BASE}/v1791647523/IMG_1282_supg1x.png`, label: 'Dashboard' },
  { src: `${BASE}/v1791647523/IMG_1283_nd2j3j.png`, label: 'Expenses' },
  { src: `${BASE}/v1791647523/IMG_1284_mqcldf.png`, label: 'Projects' },
  { src: `${BASE}/v1791647524/IMG_1286_obx3hg.png`, label: 'Categories' },
] as const;
---
<section id="app-preview" class="preview">
  <div class="container">
    <h2>See it in action</h2>
    <div class="phones">
      {SHOTS.map((s) => (
        <div class="phone">
          <div class="phone-screen">
            <img src={s.src} width="1206" height="2622" alt={`Pulse Purse — ${s.label} screen`} loading="lazy" />
          </div>
          <p class="phone-label muted">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .preview {
    padding-block: 4rem;
    border-top: 1px solid var(--border);
  }
  .preview h2 {
    font-size: 1.75rem;
    margin-bottom: 2.5rem;
    max-width: 30ch;
  }
  .phones {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 1000px;
  }
  .phone {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .phone-screen {
    width: 100%;
    aspect-ratio: 9 / 19.5;
    border-radius: 1.75rem;
    border: 1px solid var(--border);
    background: var(--card);
    overflow: hidden;
    box-shadow: 0 1px 2px color-mix(in oklab, var(--foreground) 6%, transparent);
  }
  .phone-screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .phone-label {
    font-size: 0.85rem;
  }
  .muted {
    color: var(--muted-foreground);
  }
  @media (max-width: 760px) {
    .phones {
      grid-template-columns: repeat(2, 1fr);
      max-width: 420px;
      margin-inline: auto;
    }
  }
  @media (max-width: 420px) {
    .phones {
      grid-template-columns: 1fr;
      max-width: 220px;
    }
  }
</style>
