---
import { SOCIAL_LINKS } from '../lib/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class:list={['social-links', className]}>
  <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" aria-label="Pulse Purse on Instagram">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4.2" />
      <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />
    </svg>
  </a>
  <a href={SOCIAL_LINKS.whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Pulse Purse on WhatsApp">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 20l1.3-3.9A8 8 0 1 1 8.9 19L4 20Z" />
      <path d="M8.8 9.2c.2 2.6 2.3 4.7 4.9 4.9.7 0 .7-.6.5-1.1l-.4-.9c-.1-.3-.4-.4-.7-.3l-.8.3a4.4 4.4 0 0 1-2.1-2.1l.3-.8c.1-.3 0-.6-.3-.7l-.9-.4c-.5-.2-1.1-.2-1.1.5Z" fill="currentColor" stroke="none" />
    </svg>
  </a>
  <a href={SOCIAL_LINKS.tiktok} target="_blank" rel="noopener noreferrer" aria-label="Pulse Purse on TikTok">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M13 3v10.8a3.2 3.2 0 1 1-2.4-3.1" />
      <path d="M13 3c.3 2.3 2 4 4.3 4.2" />
    </svg>
  </a>
</div>

<style>
  .social-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .social-links a {
    display: inline-flex;
    color: var(--muted-foreground);
    transition: color 160ms var(--ease-out);
  }
  .social-links a:hover {
    color: var(--foreground);
  }
</style>
